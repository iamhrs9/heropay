# ==========================================
# HeroPay Backend & Database Configuration
# Copy this file to .env and fill in values
# ==========================================

# Server Port
PORT=5001

# MongoDB Atlas Connection String (myheropay database)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/myheropay?retryWrites=true&w=majority&appName=Cluster0

# Admin Panel Password (accessed at /adminonly)
ADMIN_PASSWORD=YourSecureAdminPassword

# JWT Secret Key (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Node Environment
NODE_ENV=development

# ==========================================
# NOTE: Bank Accounts & UPI IDs are 100% dynamically
# managed in MongoDB (Collection: myheroaccounts)
# and can be Added / Edited / Deleted live via Admin Panel (/adminonly).
# The variables below are ONLY emergency offline fallbacks.
# ==========================================
VITE_BANK_NAME=Your Bank Name
VITE_ACCOUNT_NUMBER=YourAccountNumber
VITE_ACCOUNT_HOLDER=YOUR COMPANY NAME PVT LTD
VITE_IFSC_CODE=YOURIFSC0001
VITE_ACCOUNT_TYPE=Current Account
VITE_BANK_BRANCH=Your Branch, Your City
VITE_UPI_ID=yourname@bankupi
VITE_UPI_PAYEE_NAME=Your Company Name

# ==========================================
# App Business Logic (change anytime, no code edits needed)
# ==========================================
# Commission percentage as decimal (0.095 = 9.5%)
VITE_COMMISSION_RATE=0.095
# Fixed rupee fee added on top of commission
VITE_COMMISSION_FIXED=6
# Auto-approve pending orders after N minutes (if admin hasn't acted)
VITE_AUTO_APPROVE_MINUTES=15
# Max order amount that has live stock (above this shows 0 units)
VITE_MAX_STOCK_AMOUNT=9000
# Minimum custom order amount
VITE_MIN_ORDER_AMOUNT=500
# Stock fluctuation interval in milliseconds (80000 = 80 seconds)
VITE_STOCK_FLUCTUATE_MS=80000
